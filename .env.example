# =============================================================================
# ResolveAI — Enterprise AI Resolution Platform Configuration Template
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit your `.env` file to version control.
# =============================================================================

# PostgreSQL Primary Database Connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/resolveai_db"

# Cashfree Payment Gateway (Sandbox Credentials)
CASHFREE_CLIENT_ID="your_cashfree_sandbox_client_id_here"
CASHFREE_CLIENT_SECRET="your_cashfree_sandbox_client_secret_here"
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_API_URL="https://sandbox.cashfree.com/pg"
CASHFREE_API_VERSION="2025-01-01"
PAYMENT_API_TIMEOUT=10

# Hugging Face LLM API Token (starts with hf_)
HUGGINGFACEHUB_API_TOKEN="your_huggingface_api_token_here"
HUGGINGFACE_MODEL="openai/gpt-oss-20b"
HUGGINGFACE_TEMPERATURE=0.7
HUGGINGFACE_MAX_NEW_TOKENS=512

# JWT Authentication Secret
JWT_SECRET="your_super_secret_random_jwt_key_here"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440